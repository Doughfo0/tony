# LiveKit project credentials: keep these only on the server.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Create an outbound SIP trunk in LiveKit and paste its ID here.
LIVEKIT_SIP_TRUNK_ID=

# Use a separate long random token to authorize the app's dial-out requests.
TONY_CALL_API_TOKEN=replace-with-long-random-token

PORT=8787
CORS_ORIGINS=
